{
  "manifest_version": 3,
  "name": "WhatsApp Web - Forwarded Text Mode",
  "version": "1.0.1",
  "description": "Enhance WhatsApp Web with a Forwarded Text Mode for typed messages. Powered by NorthPeak Studio.",
  "author": "NorthPeak Studio",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Forwarded Text Mode • Powered by NorthPeak Studio"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["waInject.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["waInject.js", "icons/northpeak-logo.svg", "icons/file.svg"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
